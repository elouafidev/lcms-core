{
    "id": "lcmscore.seo",
    "name": "SEO & Metadata",
    "version": "1.0.0",
    "description": "Dynamic SEO meta tags, canonical URLs, and OpenGraph markup injector via hooks",
    "author": {
        "name": "LCMS Core Team",
        "email": "dev@lcmscore.local"
    },
    "compatibility": {
        "php": "^8.2",
        "cms": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Plugins\\Seo\\": "src/"
        }
    },
    "providers": [
        "Plugins\\Seo\\Providers\\SeoServiceProvider"
    ],
    "routes": {
        "web": "routes/web.php"
    },
    "permissions": [
        {
            "key": "seo.manage",
            "label": "Gérer les paramètres SEO"
        }
    ]
}
