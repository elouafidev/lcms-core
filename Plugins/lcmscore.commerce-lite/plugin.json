{
    "id": "lcmscore.commerce-lite",
    "name": "Boutique & E-Commerce Lite",
    "version": "1.0.0",
    "description": "Catalogue de produits, gestion de panier d'achat en session, encaissement et suivi des commandes pour LCMS Core",
    "author": {
        "name": "LCMS Core Team",
        "email": "dev@lcmscore.local"
    },
    "compatibility": {
        "php": "^8.2",
        "cms": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Plugins\\CommerceLite\\": "src/"
        }
    },
    "providers": [
        "Plugins\\CommerceLite\\Providers\\CommerceLiteServiceProvider"
    ],
    "routes": {
        "web": "routes/web.php"
    },
    "permissions": [
        {
            "key": "commerce.manage",
            "label": "Gérer les produits, stocks et commandes de la boutique"
        }
    ]
}
