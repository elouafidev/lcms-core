{
    "id": "lcmscore.pages",
    "name": "Static Pages",
    "version": "2.0.0",
    "description": "Static and dynamic pages management plugin with rich editor, page templates, parent-child hierarchy, scheduled publishing and featured images",
    "author": {
        "name": "LCMS Core Team",
        "email": "dev@lcmscore.local"
    },
    "compatibility": {
        "php": "^8.2",
        "cms": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Plugins\\Pages\\": "src/"
        }
    },
    "providers": [
        "Plugins\\Pages\\Providers\\PagesServiceProvider"
    ],
    "routes": {
        "web": "routes/web.php"
    },
    "permissions": [
        {
            "key": "pages.manage",
            "label": "Gérer les pages"
        }
    ]
}
