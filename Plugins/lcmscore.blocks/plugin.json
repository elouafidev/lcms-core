{
    "id": "lcmscore.blocks",
    "name": "Blocs & Sections",
    "version": "1.0.0",
    "description": "Constructeur visuel de sections et blocs de contenu réutilisables (Hero, FAQ, Témoignages, CTA, Grilles) avec rendu Blade",
    "author": {
        "name": "LCMS Core Team",
        "email": "dev@lcmscore.local"
    },
    "compatibility": {
        "php": "^8.2",
        "cms": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Plugins\\Blocks\\": "src/"
        }
    },
    "providers": [
        "Plugins\\Blocks\\Providers\\BlocksServiceProvider"
    ],
    "routes": {
        "web": "routes/web.php"
    },
    "permissions": [
        {
            "key": "blocks.manage",
            "label": "Gérer les blocs de contenu réutilisables"
        }
    ]
}
